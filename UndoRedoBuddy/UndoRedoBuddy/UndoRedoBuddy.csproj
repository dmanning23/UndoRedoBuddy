<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>UndoRedoBuddy</PackageId>
    <Version>5.0.0</Version>
    <Title>FontBuUndoRedoBuddydy</Title>
    <Authors>dmanning23</Authors>
    <description>A simple undo/redo stack using the command pattern</description>
    <PackageProjectUrl>https://github.com/dmanning23/UndoRedoBuddy</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dmanning23/UndoRedoBuddy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>monogame</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
</Project>